{
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/walking-route/:path*",
      "destination": "https://routing.openstreetmap.de/routed-foot/route/v1/foot/:path*"
    },
    {
      "source": "/driving-route/:path*",
      "destination": "https://routing.openstreetmap.de/routed-car/route/v1/driving/:path*"
    },
    {
      "source": "/valhalla-route/:path*",
      "destination": "https://valhalla1.openstreetmap.de/:path*"
    },
    {
      "source": "/wonderla/:path*",
      "destination": "https://wonderla-qr-project.vercel.app/wonderla/:path*"
    },
    {
      "source": "/qr-code/api/:path*",
      "destination": "https://wonderla-qr-project.vercel.app/qr-code/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://wonderla-qr-project.vercel.app/uploads/:path*"
    },
    {
      "source": "/qr-code/:park",
      "destination": "/"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
